{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "checkJs": false,
    "allowJs": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist/generated"
  },
  "include": [
    "src/**/*.ts"
  ]
}
