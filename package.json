{
  "name": "fitness-workbench",
  "version": "0.8.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "check:core": "tsc -p tsconfig.json --noEmit",
    "check:js": "npm run build:core && node scripts/check-js-syntax.js",
    "smoke:rules": "npm run build:core && node scripts/run-rules-smoke.js",
    "prepare:desktop": "npm run build:core && node scripts/prepare-tauri-frontend.js",
    "verify:frontend": "npm run check:core && npm run build:core && npm run check:js && npm run smoke:rules",
    "verify:desktop": "npm run verify:frontend && npm run prepare:desktop",
    "desktop:dev": "tauri dev",
    "desktop:build:app": "tauri build --no-bundle",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.5.0"
  }
}
