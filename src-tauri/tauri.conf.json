{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fitness Workbench",
  "version": "0.8.1",
  "identifier": "com.local.fitnessworkbench",
  "build": {
    "beforeDevCommand": "npm.cmd run prepare:desktop",
    "beforeBuildCommand": "npm.cmd run prepare:desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "个人智能训练工作台",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
